      "id": "set-normaliser-champs",
      "name": "Set - normaliser les champs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [280, 0]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un assistant senior de cadrage projet IA pour une entreprise media, investissement et gestion de patrimoine.\n\nTa mission est de transformer un brief metier brut en fiche projet claire, challengee et exploitable par une equipe interne, un developpeur ou un consultant no-code/low-code.\n\nRegles absolues :\n- Reformule toujours le besoin reel avant de proposer une solution.\n- Separe clairement le MVP de la version avancee.\n- Identifie les zones floues et genere les questions de clarification utiles.\n- Signale toute decision sensible : commerciale, financiere, juridique, RH ou contractuelle.\n- Ne prends jamais de decision finale sur un sujet sensible sans validation humaine.\n- Propose des solutions simples, testables et compatibles avec n8n, Next.js, Supabase et Vercel.\n- Reponds uniquement en JSON valide.\n\nFormat de sortie attendu :\n{\n  \"reformulation\": \"\",\n  \"objectif\": \"\",\n  \"hypotheses\": [],\n  \"questions_clarification\": [],\n  \"mvp\": { \"description\": \"\", \"etapes\": [] },\n  \"workflow_n8n\": [],\n  \"donnees_necessaires\": [],\n  \"risques\": [],\n  \"validation_humaine_requise\": true,\n  \"raison_validation\": \"\",\n  \"checklist_recette\": [],\n  \"prochaine_action\": \"\"\n}"
            },
            {
              "role": "user",
              "content": "Brief a analyser :\nDemandeur : {{ $json.requester_name }}\nEmail : {{ $json.requester_email }}\nPole : {{ $json.pole }}\nUrgence : {{ $json.urgency }}\nBesoin brut : {{ $json.raw_need }}\nObjectif attendu : {{ $json.expected_goal }}\nContraintes : {{ $json.constraints }}\nEcheance : {{ $json.desired_deadline }}\nOutils utilises : {{ $json.tools_used }}\nNiveau de sensibilite : {{ $json.sensitivity_level }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "openai-generer-fiche-projet",
      "name": "OpenAI - analyser et generer la fiche projet",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [560, 0],
      "credentials": {
        "openAiApi": {
          "id": "A_RECREER",
          "name": "OpenAI API - a recreer"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "validation-ia",
              "leftValue": "={{ JSON.parse($json.message?.content || $json.text || '{}').validation_humaine_requise }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "sensibilite",
              "leftValue": "={{ $('Set - normaliser les champs').item.json.sensitivity_level }}",
              "rightValue": "standard",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-validation-humaine",
      "name": "IF - verifier validation humaine",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [840, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.REFERENT_EMAIL || $('Set - normaliser les champs').item.json.requester_email }}",
        "subject": "Fiche projet a valider - {{ $('Set - normaliser les champs').item.json.pole }}",
        "message": "Bonjour,\n\nUne fiche projet necessite une validation humaine.\n\nDemandeur : {{ $('Set - normaliser les champs').item.json.requester_name }}\nPole : {{ $('Set - normaliser les champs').item.json.pole }}\nUrgence : {{ $('Set - normaliser les champs').item.json.urgency }}\nSensibilite : {{ $('Set - normaliser les champs').item.json.sensitivity_level }}\n\nFiche projet generee :\n{{ $json.message?.content || $json.text || JSON.stringify($json) }}\n\nMerci de valider les points sensibles avant toute execution.",
        "options": {}
      },
